generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  role         String    @default("user")
  tasks        Task[]
}

model Task {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  status      String @default("Pending")
  userId      Int
  user        User   @relation(fields: [userId], references: [id])
}
